<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config for Android 9+ (API 28+)
    Android 9 blocks cleartext (HTTP) traffic by default.
    This config explicitly permits cleartext for localhost so the
    Capacitor local WebView asset server can load files correctly.
-->
<network-security-config>
    <!-- Allow cleartext for localhost (Capacitor's internal WebView server) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- All other traffic uses system defaults (HTTPS required on Android 9+) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
